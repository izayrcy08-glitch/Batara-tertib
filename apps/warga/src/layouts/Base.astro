---
import "../styles/global.css"

interface Props {
  title?: string
}

const { title = "Batara Tertib — Pengawasan BBM Barito Utara" } = Astro.props
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Layanan pengawasan distribusi BBM 5 SPBU di Kabupaten Barito Utara, Muara Teweh." />
    <meta name="theme-color" content="#E31E24" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Header fascia -->
    <header class="w-full" style="background-color: var(--bt-fascia);">
      <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
        <div>
          <h1
            class="text-xl font-bold tracking-wide uppercase text-[var(--bt-struk)]"
            style="font-family: var(--bt-font-display);"
          >
            Batara Tertib
          </h1>
          <p class="text-xs text-[var(--bt-struk)]/70">
            Pengawasan BBM · Barito Utara
          </p>
        </div>
      </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="max-w-3xl mx-auto px-4 py-4 text-center text-xs text-[var(--bt-tinta)]/40">
      Batara Tertib v0 · Kabupaten Barito Utara, Muara Teweh
    </footer>
  </body>
</html>
