---
import Base from "../layouts/Base.astro"

const spbuList = [
  "SPBU PERUSDA",
  "SPBU JL PENDREH",
  "SPBU JL PRAMUKA",
  "SPBU KM 2 JL BRIGJEN KATAMSO",
  "SPBU JINGAH",
]
---

<Base title="Kirim Aduan — Batara Tertib">
  <a href="/" class="inline-flex items-center gap-1 text-sm text-[var(--bt-fascia)] mb-6 hover:underline">
    ← Kembali
  </a>

  <h2
    class="text-2xl font-bold mb-1"
    style="font-family: var(--bt-font-display);"
  >
    Kirim Aduan
  </h2>
  <p class="text-sm text-[var(--bt-tinta)]/60 mb-6">
    Laporan Anda tercatat sebagai anonim.
  </p>

  <form id="form-aduan" class="flex flex-col gap-5">
    <!-- Pilih SPBU -->
    <div class="flex flex-col gap-1.5">
      <label
        for="spbu"
        class="text-sm font-medium"
      >
        SPBU yang diadukan
      </label>
      <select
        id="spbu"
        name="spbu"
        required
        class="h-10 w-full rounded-md border border-[var(--bt-tinta)]/15 bg-white px-3 text-sm outline-none focus:border-[var(--bt-fascia)] focus:ring-2 focus:ring-[var(--bt-fascia)]/20"
      >
        <option value="" disabled selected>Pilih SPBU</option>
        {spbuList.map((s) => (
          <option value={s}>{s}</option>
        ))}
      </select>
    </div>

    <!-- Judul / tema aduan -->
    <div class="flex flex-col gap-1.5">
      <label
        for="judul"
        class="text-sm font-medium"
      >
        Judul aduan
      </label>
      <input
        id="judul"
        name="judul"
        type="text"
        required
        placeholder="Contoh: Antrian lama, stok Pertalite kosong"
        class="h-10 w-full rounded-md border border-[var(--bt-tinta)]/15 bg-white px-3 text-sm outline-none focus:border-[var(--bt-fascia)] focus:ring-2 focus:ring-[var(--bt-fascia)]/20 placeholder:text-[var(--bt-tinta)]/35"
      />
    </div>

    <!-- Masalah -->
    <div class="flex flex-col gap-1.5">
      <label
        for="masalah"
        class="text-sm font-medium"
      >
        Jelaskan masalah
      </label>
      <textarea
        id="masalah"
        name="masalah"
        required
        rows="4"
        placeholder="Ceritakan kronologi atau keluhan Anda"
        class="w-full rounded-md border border-[var(--bt-tinta)]/15 bg-white px-3 py-2 text-sm outline-none focus:border-[var(--bt-fascia)] focus:ring-2 focus:ring-[var(--bt-fascia)]/20 placeholder:text-[var(--bt-tinta)]/35 resize-y"
      ></textarea>
    </div>

    <!-- Bukti dukung opsional -->
    <div class="flex flex-col gap-1.5">
      <label
        for="bukti"
        class="text-sm font-medium"
      >
        Bukti pendukung
        <span class="font-normal text-[var(--bt-tinta)]/45">(opsional)</span>
      </label>
      <input
        id="bukti"
        name="bukti"
        type="file"
        accept="image/*"
        class="text-sm file:mr-3 file:rounded-md file:border-0 file:bg-[var(--bt-fascia)]/10 file:px-3 file:py-2 file:text-sm file:font-medium file:text-[var(--bt-fascia)] file:cursor-pointer hover:file:bg-[var(--bt-fascia)]/20"
      />
      <p class="text-xs text-[var(--bt-tinta)]/45">
        Foto atau screenshot. Maks 5 MB.
      </p>
    </div>

    <!-- Tombol kirim -->
    <button
      type="submit"
      disabled
      class="group relative h-12 w-full overflow-hidden rounded-lg font-bold text-sm tracking-wide uppercase disabled:cursor-not-allowed transition-all"
      style="background-color: var(--bt-fascia); font-family: var(--bt-font-display);"
    >
      <span class="relative z-10 inline-flex items-center gap-2 text-[var(--bt-struk)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
        Kirim Aduan
      </span>
      <span
        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        style="background: linear-gradient(135deg, var(--bt-fascia), var(--bt-pertalite));"
      ></span>
    </button>
    <p class="text-xs text-center text-[var(--bt-tinta)]/40 mt-1">
      Belum terhubung ke server — segera hadir.
    </p>
  </form>
</Base>
