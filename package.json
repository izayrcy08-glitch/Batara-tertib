{
  "name": "batara-tertib",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:pom": "npm run dev -w apps/pom",
    "dev:warga": "npm run dev -w apps/warga",
    "build:pom": "npm run build -w apps/pom",
    "build:warga": "npm run build -w apps/warga",
    "build": "npm run build:pages",
    "build:pages": "npm run build:warga && npm run build:pom && node scripts/merge-pages.mjs",
    "deploy": "npx wrangler deploy"
  }
}
